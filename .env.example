# 本文件为模板。复制为 .env.local 后填入真实值（`.env*.local` 已被 .gitignore 排除，不会进入 git 历史）。
#
# 用法：
#   Copy-Item .env.example .env.local
#   然后编辑 .env.local 填入真实值
#
# 生产环境的 3 个必填项也可在 Vercel Dashboard → Project → Settings → Environment Variables 配置。

# ─── MCP Rate Limit（Upstash Redis）────────────────────────────────────────
# 生产必填。留空时软降级为 in-memory limiter（仅单实例有效 + 启动时 warn 日志）。
# 免费档：https://console.upstash.com/ → Create Database → Redis（建议 region 与 Vercel region 对齐）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── MCP Origin 白名单（生产）──────────────────────────────────────────────
# 逗号分隔，支持通配符 `https://*.example.com`。
#   · 留空 → 拒绝所有非空 Origin（CLI / 无 Origin 仍放行）
#   · 浏览器端 fetch 必须包含正式域名
# 示例：`https://papeltools.com,https://www.papeltools.com`
ALLOWED_ORIGINS=

# ─── MCP 远程 URL（可选）───────────────────────────────────────────────────
# server-card.json 与 initialize 响应的 public URL。默认 `https://papeltools.com/api/mcp`。
# 本地开发时建议覆盖为 `http://localhost:3000/api/mcp`（便于 MCP Inspector / Claude Desktop 本地调试）。
MCP_REMOTE_URL=

# ─── Node 环境（可选，覆盖 Next.js 默认值）─────────────────────────────────
# 默认 `development`；部署到 Vercel 后会自动设为 `production`，触发 Origin 校验与限流软降级告警。
# NODE_ENV=
