    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.7.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}